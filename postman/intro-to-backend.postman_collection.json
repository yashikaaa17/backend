{
  "info": {
    "name": "Intro to Backend API",
    "_postman_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
    "description": "Postman collection for the Intro to Backend project — User auth and Post CRUD APIs.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Users",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"john_doe\",\n  \"email\": \"john@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "users", "register"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"Response contains user data\", function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.have.property(\"message\");",
                  "    pm.expect(json).to.have.property(\"user\");",
                  "    pm.expect(json.user).to.have.property(\"id\");",
                  "    pm.expect(json.user).to.have.property(\"email\");",
                  "    pm.expect(json.user).to.have.property(\"username\");",
                  "});",
                  "pm.test(\"Password is not exposed in response\", function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.user).to.not.have.property(\"password\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Login User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "users", "login"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Response contains login success message\", function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.have.property(\"message\");",
                  "    pm.expect(json).to.have.property(\"user\");",
                  "});",
                  "pm.test(\"Password is not exposed in response\", function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.user).to.not.have.property(\"password\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Logout User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john@example.com\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/logout",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "users", "logout"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Response contains logout success message\", function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.have.property(\"message\");",
                  "    pm.expect(json.message).to.include(\"Logout\");",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Posts",
      "item": [
        {
          "name": "Create Post",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"My First Post\",\n  \"description\": \"This is my first backend project post\",\n  \"age\": 20\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/posts/create",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "posts", "create"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"Response contains created post\", function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.have.property(\"message\");",
                  "    pm.expect(json).to.have.property(\"post\");",
                  "    pm.expect(json.post).to.have.property(\"_id\");",
                  "});",
                  "if (pm.response.code === 201) {",
                  "    const json = pm.response.json();",
                  "    pm.collectionVariables.set(\"postId\", json.post._id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Get All Posts",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/posts/getPosts",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "posts", "getPosts"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Response contains posts array\", function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.have.property(\"posts\");",
                  "    pm.expect(json.posts).to.be.an(\"array\");",
                  "});"
                ]
              }
            }
          ]
        },
