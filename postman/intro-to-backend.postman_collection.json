                  "});",
                  "pm.test(\"Response contains updated post\", function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.have.property(\"message\");",
                  "    pm.expect(json).to.have.property(\"post\");",
                  "});"
                ]
              }
            }
          ]
        },
